# Copy to .env for local development. Never commit .env.
AZALEA_STAFF_PASSWORD=replace-with-a-strong-password
PORT=8787

# Optional: override where drawings and accounts are stored (for cloud deploys)
# AZALEA_DATA_DIR=/data

# Optional: when building a static site (GitHub Pages) that talks to a remote API
# VITE_API_BASE=https://your-api-host.example.com
